def zhou3Gen1 : Equiv.Perm (Fin 182) where
  toFun i := zhou3Gen1Fwd[i.val]'(by have := zhou3Gen1Fwd_size; omega)
  invFun i := zhou3Gen1Inv[i.val]'(by have := zhou3Gen1Inv_size; omega)
  left_inv := by native_decide
  right_inv := by native_decide

def zhou3Gen2 : Equiv.Perm (Fin 182) where
  toFun i := zhou3Gen2Fwd[i.val]'(by have := zhou3Gen2Fwd_size; omega)
  invFun i := zhou3Gen2Inv[i.val]'(by have := zhou3Gen2Inv_size; omega)
  left_inv := by native_decide
  right_inv := by native_decide

def zhou3Gens : Fin 2 → Equiv.Perm (Fin 182)
  | 0 => zhou3Gen1
  | 1 => zhou3Gen2

theorem zhou3Gen1_adj : ∀ u v : Fin 182,
    zhou3Graph.Adj u v → zhou3Graph.Adj (zhou3Gen1 u) (zhou3Gen1 v) := by
  native_decide

theorem zhou3Gen1_inv_adj : ∀ u v : Fin 182,
    zhou3Graph.Adj u v → zhou3Graph.Adj (zhou3Gen1.symm u) (zhou3Gen1.symm v) := by
  native_decide

theorem zhou3Gen2_adj : ∀ u v : Fin 182,
