    ∀ v : Fin 182, applyWordGen zhou3Gens (zhou3WitnessWords v) 0 = v := by
  native_decide

/-! ## Sabidussi witness -/

def zhou3SabidussiWitness : SabidussiWitness zhou3Graph where
  numGens := 2
  gens := zhou3Gens
  gens_preserve_adj := by
    intro i; match i with
    | ⟨0, _⟩ => exact zhou3Gen1_adj
    | ⟨1, _⟩ => exact zhou3Gen2_adj
  gens_inv_preserve_adj := by
    intro i; match i with
    | ⟨0, _⟩ => exact zhou3Gen1_inv_adj
    | ⟨1, _⟩ => exact zhou3Gen2_inv_adj
  base := 0
  witnessWords := zhou3WitnessWords
  witness_correct := zhou3Witness_correct

noncomputable def zhou3SabidussiIso := zhou3SabidussiWitness.toSabidussiIso
