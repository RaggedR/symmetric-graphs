# Sabidussi Witness: proving graphs are coset graphs via generators

Given a graph `Γ : SimpleGraph (Fin n)`, a **Sabidussi witness** consists of
generator permutations that preserve adjacency plus BFS witness words
showing transitivity. From this we derive `GraphAction` and
`IsPretransitive` and apply `sabidussiIso`.
-/

import CSSCode.SabidussiRepresentation
import Mathlib.Algebra.Group.Subgroup.Basic

/-! ## Word application -/

section WordApplication

variable {n k : ℕ}

/-- Given `k` generators, the `2k` generators-and-inverses.
    Indices `0, ..., k-1` are generators; `k, ..., 2k-1` are inverses. -/
def genOrInv (gens : Fin k → Equiv.Perm (Fin n)) (i : Fin (2 * k)) :
    Equiv.Perm (Fin n) :=
  if h : i.val < k then
    gens ⟨i.val, h⟩
  else
    (gens ⟨i.val - k, by omega⟩).symm

/-- Apply a word (list of generator-or-inverse indices) to get a permutation. -/
def applyWordGen (gens : Fin k → Equiv.Perm (Fin n)) :
    List (Fin (2 * k)) → Equiv.Perm (Fin n)
  | [] => Equiv.refl _
  | i :: rest => (genOrInv gens i).trans (applyWordGen gens rest)

/-- Each generator is in the closure. -/
theorem gen_mem_closure (gens : Fin k → Equiv.Perm (Fin n)) (i : Fin k) :
    gens i ∈ Subgroup.closure (Set.range gens) :=
  Subgroup.subset_closure (Set.mem_range.mpr ⟨i, rfl⟩)

/-- Each generator-or-inverse is in the closure. -/
theorem genOrInv_mem_closure (gens : Fin k → Equiv.Perm (Fin n))
    (i : Fin (2 * k)) :
    genOrInv gens i ∈ Subgroup.closure (Set.range gens) := by
  unfold genOrInv
  split
  · case isTrue h =>
    exact gen_mem_closure gens ⟨i.val, h⟩
  · case isFalse h =>
    exact Subgroup.inv_mem _ (gen_mem_closure gens ⟨i.val - k, by omega⟩)

/-- Any word product is in the closure of the generators.
    Uses the fact that for `Equiv.Perm`, `σ.trans τ = τ * σ`. -/
theorem applyWordGen_mem_closure (gens : Fin k → Equiv.Perm (Fin n))
    (w : List (Fin (2 * k))) :
    applyWordGen gens w ∈ Subgroup.closure (Set.range gens) := by
  induction w with
  | nil => exact Subgroup.one_mem _
  | cons i rest ih =>
    -- applyWordGen (i :: rest) = (genOrInv i).trans (applyWordGen rest)
    -- For Perm: σ.trans τ = τ * σ (by definition of Mul on Perm)
    show (genOrInv gens i).trans (applyWordGen gens rest) ∈ _
    -- This equals (applyWordGen rest) * (genOrInv i) definitionally
    exact Subgroup.mul_mem _ ih (genOrInv_mem_closure gens i)

end WordApplication

/-! ## The Sabidussi witness structure -/

/-- A **Sabidussi witness** for `Γ : SimpleGraph (Fin n)` proves that `Γ` is a
coset graph by exhibiting generators of a vertex-transitive group action. -/
structure SabidussiWitness {n : ℕ} (Γ : SimpleGraph (Fin n)) where
  /-- Number of generators -/
  numGens : ℕ
  /-- The generator permutations -/
  gens : Fin numGens → Equiv.Perm (Fin n)
  /-- Each generator preserves adjacency -/
  gens_preserve_adj : ∀ (i : Fin numGens) (u v : Fin n),
    Γ.Adj u v → Γ.Adj (gens i u) (gens i v)
  /-- Each generator inverse preserves adjacency -/
  gens_inv_preserve_adj : ∀ (i : Fin numGens) (u v : Fin n),
    Γ.Adj u v → Γ.Adj ((gens i).symm u) ((gens i).symm v)
  /-- Basepoint for the BFS -/
  base : Fin n
  /-- BFS witness words: for each vertex, a word mapping base → v -/
  witnessWords : Fin n → List (Fin (2 * numGens))
  /-- Each witness word correctly maps base to its target -/
  witness_correct : ∀ v : Fin n, applyWordGen gens (witnessWords v) base = v

namespace SabidussiWitness

variable {n : ℕ} {Γ : SimpleGraph (Fin n)} (W : SabidussiWitness Γ)

/-- The group generated by the witness generators, as a subgroup of Sym(n). -/
def group : Subgroup (Equiv.Perm (Fin n)) :=
  Subgroup.closure (Set.range W.gens)

/-- The generated group preserves adjacency.

Uses `Subgroup.closure_induction` with the finiteness argument for
the inverse case: an injective self-map on the finite set of edges
is surjective (pigeonhole). -/
theorem group_preserves_adj (σ : Equiv.Perm (Fin n)) (hσ : σ ∈ W.group) :
    ∀ u v : Fin n, Γ.Adj u v → Γ.Adj (σ u) (σ v) := by
  induction hσ using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := Set.mem_range.mp hx
    exact W.gens_preserve_adj i
  | one => simp
  | mul x y _ _ ihx ihy =>
    intro u v hadj
    simp only [Equiv.Perm.mul_apply]
    exact ihx _ _ (ihy u v hadj)
  | inv x _ ih =>
    intro u v hadj
    -- σ' preserves adj forward. We need σ'⁻¹ preserves adj forward.
    -- The map on directed edges is an injective self-map on a finite type,
    -- hence surjective. Every edge has a preimage under σ'.
    let f : { p : Fin n × Fin n // Γ.Adj p.1 p.2 } →
            { p : Fin n × Fin n // Γ.Adj p.1 p.2 } :=
      fun ⟨⟨a, b⟩, hab⟩ => ⟨⟨x a, x b⟩, ih a b hab⟩
    have hf_inj : Function.Injective f := by
      intro ⟨⟨a₁, b₁⟩, _⟩ ⟨⟨a₂, b₂⟩, _⟩ h
      simp only [f, Subtype.mk.injEq, Prod.mk.injEq] at h
      exact Subtype.ext (Prod.ext (x.injective h.1) (x.injective h.2))
    have hf_surj : Function.Surjective f := Finite.surjective_of_injective hf_inj
    obtain ⟨⟨⟨a, b⟩, hab⟩, heq⟩ := hf_surj ⟨⟨u, v⟩, hadj⟩
    simp only [f, Subtype.mk.injEq, Prod.mk.injEq] at heq
    rw [show a = x⁻¹ u from by rw [← heq.1]; simp,
        show b = x⁻¹ v from by rw [← heq.2]; simp] at hab
    exact hab

/-- The action of the generated group on `Fin n`. -/
noncomputable instance groupMulAction : MulAction W.group (Fin n) :=
  MulAction.compHom (Fin n) W.group.subtype

/-- The generated group acts on `Γ` preserving adjacency. -/
noncomputable instance groupGraphAction : GraphAction W.group (Fin n) Γ where
  adj_smul := by
    intro ⟨σ, hσ⟩ u v hadj
    exact W.group_preserves_adj σ hσ u v hadj

/-- The generated group acts transitively on `Fin n`. -/
noncomputable instance groupPretransitive :
    MulAction.IsPretransitive W.group (Fin n) where
  exists_smul_eq := by
    intro x y
    let σ_x := applyWordGen W.gens (W.witnessWords x)
    let σ_y := applyWordGen W.gens (W.witnessWords y)
    have hx_mem : σ_x ∈ W.group := applyWordGen_mem_closure W.gens (W.witnessWords x)
    have hy_mem : σ_y ∈ W.group := applyWordGen_mem_closure W.gens (W.witnessWords y)
    have hmem : σ_x.symm.trans σ_y ∈ W.group :=
      W.group.mul_mem hy_mem (W.group.inv_mem hx_mem)
    refine ⟨⟨σ_x.symm.trans σ_y, hmem⟩, ?_⟩
    show (σ_x.symm.trans σ_y) x = y
    simp only [Equiv.trans_apply]
    have hx : σ_x W.base = x := W.witness_correct x
    have hy : σ_y W.base = y := W.witness_correct y
    rw [show σ_x.symm x = W.base from by rw [Equiv.symm_apply_eq]; exact hx.symm]
    exact hy

/-- **The graph `Γ` is a Sabidussi coset graph.**

Given a Sabidussi witness, `Γ` is isomorphic to the coset graph
`Sab(G, Stab_G(base), D)` where `G` is the group generated by the
witness generators. -/
noncomputable def toSabidussiIso :
    Γ ≃g SimpleGraph.cosetGraph (MulAction.stabilizer W.group W.base)
      (connectionSet W.group Γ W.base)
      (connectionSet.isConnectionSet W.base) :=
  sabidussiIso W.base

end SabidussiWitness
