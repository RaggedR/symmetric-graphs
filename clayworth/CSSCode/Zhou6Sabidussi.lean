theorem zhou6Witness_correct :
    ∀ v : Fin 91, applyWordGen zhou6Gens (zhou6WitnessWords v) 0 = v := by
  native_decide

/-! ## Sabidussi witness -/

def zhou6SabidussiWitness : SabidussiWitness zhou6Graph where
  numGens := 2
  gens := zhou6Gens
  gens_preserve_adj := by
    intro i; match i with
    | ⟨0, _⟩ => exact zhou6Gen1_adj
    | ⟨1, _⟩ => exact zhou6Gen2_adj
  gens_inv_preserve_adj := by
    intro i; match i with
    | ⟨0, _⟩ => exact zhou6Gen1_inv_adj
    | ⟨1, _⟩ => exact zhou6Gen2_inv_adj
  base := 0
  witnessWords := zhou6WitnessWords
  witness_correct := zhou6Witness_correct

noncomputable def zhou6SabidussiIso := zhou6SabidussiWitness.toSabidussiIso
