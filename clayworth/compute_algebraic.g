LoadPackage("grape");;

BFS := function(gens, n, base)
  local words, allGens, k, queue, v, gi, nv;
  k := Length(gens);
  allGens := Concatenation(gens, List(gens, g -> g^(-1)));
  words := List([1..n], i -> fail);
  words[base] := [];
  queue := [base];
  while Length(queue) > 0 do
    v := Remove(queue, 1);
    for gi in [1..2*k] do
      nv := v ^ allGens[gi];
      if words[nv] = fail then
        words[nv] := Concatenation(words[v], [gi-1]);
        Add(queue, nv);
      fi;
    od;
  od;
  return words;
end;;

# Compute coset graph data from a group G and subgroup H
# Returns: [gens, words, adj_matrix, cubicOrb]
CosetGraphData := function(G, H, name)
  local act, img, n, gens, g1, g2, orbs, cubOrb, adjMat, v, w, rep, words, i;
  act := FactorCosetAction(G, H);;
  img := Image(act);;
  n := NrMovedPoints(img);;
  Print(name, ": |G| = ", Size(G), ", |H| = ", Size(H), ", n = ", n, "\n");

  gens := GeneratorsOfGroup(img);;
  g1 := gens[1]; g2 := gens[Length(gens)];;
  # Ensure 2 generators that act transitively
  if not IsTransitive(Group(g1, g2), [1..n]) then
    for i in [2..Length(gens)] do
      if IsTransitive(Group(g1, gens[i]), [1..n]) then
        g2 := gens[i]; break;
      fi;
    od;
  fi;
  Print(name, " transitive: ", IsTransitive(Group(g1,g2), [1..n]), "\n");

  # Find cubic orbital (degree-3 or degree-6 etc.)
  orbs := Orbits(Stabilizer(img, 1), [1..n]);;
  Print(name, " orbital sizes: ", List(orbs, Length), "\n");

  # Build adjacency from smallest non-trivial orbital
  cubOrb := First(orbs, o -> Length(o) > 0 and Length(o) <= 6 and not (1 in o));;
  if cubOrb = fail then
    cubOrb := First(orbs, o -> Length(o) > 0 and not (1 in o));;
  fi;
  Print(name, " orbital for adjacency: ", cubOrb, " (size ", Length(cubOrb), ")\n");

  # Build adjacency matrix
  adjMat := NullMat(n, n);;
  for v in [1..n] do
    rep := RepresentativeAction(img, 1, v);
    for w in cubOrb do
      nv := w^rep;
      adjMat[v][nv] := 1;
      adjMat[nv][v] := 1;
    od;
  od;

  # Verify regularity
  Print(name, " degree: ", Sum(adjMat[1]), "\n");

  words := BFS([g1, g2], n, 1);;
  Print(name, " BFS complete: ", ForAll(words, w -> w <> fail), "\n");

  return rec(g1 := g1, g2 := g2, words := words, adjMat := adjMat,
             cubOrb := cubOrb, n := n, img := img);
end;;

# Save all data for one graph to a file
SaveGraphData := function(data, filename, prefix)
  local n, v, edges;
  n := data.n;
  PrintTo(filename, "");
  AppendTo(filename, prefix, "N := ", n, ";\n");
  AppendTo(filename, prefix, "Gen1Fwd := ", List([1..n], v -> v^data.g1-1), ";\n");
  AppendTo(filename, prefix, "Gen1Inv := ", List([1..n], v -> v^(data.g1^-1)-1), ";\n");
  AppendTo(filename, prefix, "Gen2Fwd := ", List([1..n], v -> v^data.g2-1), ";\n");
  AppendTo(filename, prefix, "Gen2Inv := ", List([1..n], v -> v^(data.g2^-1)-1), ";\n");
  AppendTo(filename, prefix, "Words := ", data.words, ";\n");
  # Edge list (0-indexed, upper triangle)
  edges := [];
  for v in [1..n] do
    for w in [v+1..n] do
      if data.adjMat[v][w] = 1 then Add(edges, [v-1, w-1]); fi;
    od;
  od;
  AppendTo(filename, prefix, "Edges := ", edges, ";\n");
  AppendTo(filename, prefix, "NumEdges := ", Length(edges), ";\n");
  Print("Saved to ", filename, " (", Length(edges), " edges)\n");
end;;

# ============================================================
# ALL GRAPHS
# ============================================================

# --- DODECAHEDRON: A5 / C3 ---
a5 := AlternatingGroup(5);;
c3_a5 := Group((1,2,3));;
dodec := CosetGraphData(a5, c3_a5, "Dodec");;
SaveGraphData(dodec, "/tmp/dodec_data.g", "dodec");;

# --- PETERSEN: A5 / S3 ---
# S3 = <(1,2), (1,2,3)> < A5? No, (1,2) is odd.
# S3 in A5: generated by (1,2,3) and (1,2)(4,5)
s3_a5 := Group((1,2,3), (1,2)(4,5));;
Print("|S3| = ", Size(s3_a5), "\n");
pet := CosetGraphData(a5, s3_a5, "Petersen");;
SaveGraphData(pet, "/tmp/petersen_data.g", "pet");;

# --- HEAWOOD: PGL(2,7) / C6 or use smaller group ---
# Heawood = Sab(G42, C3) where G42 = Z7 : Z6
# Or: Heawood = Sab(PGL(2,7), C24) with 336/24 = 14
# Simplest: use the automorphism group PGL(2,7) of order 336
pgl27 := PGL(2,7);;
# Need a subgroup of index 14: |H| = 336/14 = 24
h24 := First(ConjugacyClassesSubgroups(pgl27), c -> Size(Representative(c)) = 24);;
if h24 <> fail then
  heaw := CosetGraphData(pgl27, Representative(h24), "Heawood");;
  SaveGraphData(heaw, "/tmp/heawood_data.g", "heaw");;
else
  Print("No subgroup of order 24 in PGL(2,7)!\n");
  # Try index 14 directly
  subs14 := Filtered(ConjugacyClassesSubgroups(pgl27), c -> Index(pgl27, Representative(c)) = 14);;
  Print("Subgroups of index 14: ", List(subs14, c -> Size(Representative(c))), "\n");
  h := Representative(subs14[1]);;
  heaw := CosetGraphData(pgl27, h, "Heawood");;
  SaveGraphData(heaw, "/tmp/heawood_data.g", "heaw");;
fi;

# --- MK: GL(2,3) / C3 ---
gl23 := GL(2,3);;
Print("|GL(2,3)| = ", Size(gl23), "\n");
c3_gl := First(ConjugacyClassesSubgroups(gl23), c -> Size(Representative(c)) = 3);;
mk := CosetGraphData(gl23, Representative(c3_gl), "MK");;
SaveGraphData(mk, "/tmp/mk_data.g", "mk");;

# --- KLEIN: PSL(2,7) / C3 ---
psl27 := PSL(2,7);;
c3_psl := First(ConjugacyClassesSubgroups(psl27), c -> Size(Representative(c)) = 3);;
klein := CosetGraphData(psl27, Representative(c3_psl), "Klein");;
SaveGraphData(klein, "/tmp/klein_data.g", "klein");;

# --- ZHOU-3: PSL(2,13) / S3 ---
psl213 := PSL(2,13);;
s3_psl := First(ConjugacyClassesSubgroups(psl213), c -> Size(Representative(c)) = 6);;
zhou3 := CosetGraphData(psl213, Representative(s3_psl), "Zhou3");;
SaveGraphData(zhou3, "/tmp/zhou3_data.g", "zhou3");;

# --- ZHOU-6: PSL(2,13) / D12 ---
d12_psl := First(ConjugacyClassesSubgroups(psl213), c -> Size(Representative(c)) = 12);;
zhou6 := CosetGraphData(psl213, Representative(d12_psl), "Zhou6");;
SaveGraphData(zhou6, "/tmp/zhou6_data.g", "zhou6");;

# --- CLAYWORTH: G2(2) / C3 (zero fixed points) ---
g2 := PrimitiveGroup(63, 1);;
c3cls := Filtered(ConjugacyClassesSubgroups(g2), c -> Size(Representative(c)) = 3);;
cw3 := First(c3cls, cl ->
  Number([1..63], p -> p^GeneratorsOfGroup(Representative(cl))[1] = p) = 0);;
if cw3 <> fail then
  Print("Found Clayworth C3\n");
  clayw := CosetGraphData(g2, Representative(cw3), "Clayworth");;
  SaveGraphData(clayw, "/tmp/clayworth_data.g", "clayw");;
else
  Print("No Clayworth C3 found!\n");
fi;

Print("\n=== ALL DONE ===\n");
QuitGap(0);
