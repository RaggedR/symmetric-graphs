# Build W(E8) as a permutation group acting on the 240 roots
# This creates the permutation representation we need for all subsequent computations

Print("Building W(E8) from simple reflections...\n\n");

# E8 simple roots (Bourbaki numbering)
# Using exact rational coordinates
e := IdentityMat(8);;

a1 := (1/2) * (e[1] - e[2] - e[3] - e[4] - e[5] - e[6] - e[7] + e[8]);;
a2 := e[1] + e[2];;
a3 := e[2] - e[1];;
a4 := e[3] - e[2];;
a5 := e[4] - e[3];;
a6 := e[5] - e[4];;
a7 := e[6] - e[5];;
a8 := e[7] - e[6];;

simple := [a1, a2, a3, a4, a5, a6, a7, a8];;

Print("Simple roots:\n");
for i in [1..8] do
    Print("  a", i, " = ", simple[i], "\n");
od;
Print("\n");

# Generate all 240 roots by applying Weyl reflections
# Start with simple roots and repeatedly reflect
roots := Set(simple);;
queue := ShallowCopy(simple);;
max_iter := 1000;;
iter := 0;;

while Length(queue) > 0 and iter < max_iter do
    iter := iter + 1;
    r := Remove(queue, 1);;

    # Apply all simple reflections to r
    for a in simple do
        # Reflection: s_a(v) = v - 2(v.a)/(a.a) * a
        # Since a.a = 2 for all simple roots, this is v - (v.a)*a
        ip := r * a;;  # inner product
        new_root := r - ip * a;;

        if not new_root in roots then
            AddSet(roots, new_root);;
            Add(queue, new_root);;
        fi;
    od;
od;

Print("Generated ", Length(roots), " roots (expect 240)\n");

# Verify all roots have length^2 = 2
all_length_2 := ForAll(roots, r -> r * r = 2);
Print("All roots have length^2 = 2: ", all_length_2, "\n\n");

# Create lookup for root indices
root_list := AsSortedList(roots);;
root_to_index := function(r)
    return Position(root_list, r);
end;

# Build permutation generators (simple reflections acting on roots)
Print("Building permutation representation...\n");
gens := [];;

for i in [1..8] do
    a := simple[i];;
    perm_list := [];;

    for j in [1..Length(root_list)] do
        r := root_list[j];;
        # s_a(r) = r - (r.a)*a
        ip := r * a;;
        new_root := r - ip * a;;
        new_index := root_to_index(new_root);;
        perm_list[j] := new_index;;
    od;

    perm := PermList(perm_list);;
    Add(gens, perm);;
    Print("  s", i, " generated (order ", Order(perm), ")\n");
od;

Print("\n");

# Create the group
G := Group(gens);;
Print("Group created with ", Length(gens), " generators\n");
Print("Computing group order...\n");
order := Size(G);;
Print("|W(E8)| = ", order, " (expect 696729600)\n\n");

if order <> 696729600 then
    Print("WARNING: Group size mismatch!\n");
fi;

# Save to file for other scripts
PrintTo("/tmp/e8_perms.g",
    "# W(E8) permutation representation on 240 roots\n",
    "# Generated by build_e8_weyl.g\n\n",
    "gens := ", gens, ";;\n"
);;

Print("✓ Saved to /tmp/e8_perms.g\n");
Print("✓ Ready for conjugacy class enumeration\n");
